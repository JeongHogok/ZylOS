Zyl OS boot policy for the SpacemiT K1 U-Boot (spacemit-com/uboot-2022.10,
the commit tools/build-bootloader.sh pins).

- CONFIG_ZYL_OS: storage may set only the variables include/zyl_env_flags.h
  lists (tools/build-bootloader.sh writes it from board/bpi-f3/u-boot-env.txt);
  no environment from bootfs, no automatic flashing from an SD card, no shell
  on request; zyl_serial sets serial# (the device tree's serial-number, the
  OS's device ID) from the chip ID in eFuse
- CONFIG_ZYL_ROTPK_BURN: zyl_rotpk burn — fuse the Root of Trust public key
  hash (bank 4) and lock it, only if the FSBL in eMMC boot0 is the one this
  build signed (include/zyl_rotpk.h)

diff --git a/board/spacemit/k1-x/Kconfig b/board/spacemit/k1-x/Kconfig
index ea5c6b51..d9212615 100644
--- a/board/spacemit/k1-x/Kconfig
+++ b/board/spacemit/k1-x/Kconfig
@@ -33,6 +33,25 @@ config SPACEMIT_BUILD_BIN
 	bool "build fsbl.bin for spacemit image"
 	default n
 
+config ZYL_OS
+	bool "Zyl OS boot policy"
+	depends on SPACEMIT_K1X_EFUSE && ENV_WRITEABLE_LIST
+	help
+	  The boot policy of a Zyl OS device (its board/bpi-f3/u-boot-env.txt):
+	  storage may set only the variables include/zyl_env_flags.h lists; no
+	  environment from bootfs or the network, no automatic flashing from an
+	  SD card, no shell on request. Adds zyl_serial: serial# (the device
+	  tree's serial-number, the OS's device ID) from the chip ID in eFuse.
+
+config ZYL_ROTPK_BURN
+	bool "Zyl OS: burn the Root of Trust public key hash into eFuse"
+	depends on ZYL_OS
+	help
+	  Adds "zyl_rotpk burn": programs eFuse bank 4 (ROTPKH) and locks it,
+	  only if the FSBL in eMMC boot0 is exactly the one this build signed
+	  (include/zyl_rotpk.h). Irreversible. The vendor does not document the
+	  hash the Boot ROM expects: try it on a board you can afford to lose.
+
 config BOARD_SPECIFIC_OPTIONS # dummy
 	def_bool y
 	select SPACEMIT_X60
