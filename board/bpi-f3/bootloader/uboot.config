# ──────────────────────────────────────────────────────────
# [Clean Architecture] Infrastructure Layer - Bootloader Config
#
# 역할: 제조사 U-Boot(k1_defconfig) 위에 얹는 Zyl OS 설정 조각
# 수행범위: 서명 검증(SPL → OpenSBI·U-Boot, U-Boot → OS), 부트 정책 내장
#           (u-boot-env.txt, 저장소는 런타임 상태만), 셸·환경 외부 접근 차단
# 의존방향: tools/build-bootloader.sh 가 merge_config.sh 로 합치고, 결과
#           .config 에 그대로 남았는지 확인한다
# SOLID: SRP — 부트로더 빌드 설정만
# ──────────────────────────────────────────────────────────

# Signatures: the SPL checks OpenSBI and U-Boot (key in the FSBL the Boot ROM
# checks), U-Boot checks the OS. The vendor config leaves RSA out, so nothing
# was actually verified.
CONFIG_RSA=y
CONFIG_SPL_RSA=y
CONFIG_RSA_VERIFY=y
CONFIG_SPL_RSA_VERIFY=y
CONFIG_FIT_SIGNATURE=y
CONFIG_SPL_FIT_SIGNATURE=y
CONFIG_SHA256=y
CONFIG_SPL_SHA256=y
# ...which costs the SPL room in SRAM (CONFIG_SPL_SIZE_LIMIT): it gives back
# what the BPI-F3 does not use — images over USB SDP, MBR partition tables (GPT)
# CONFIG_SPL_USB_SDP_SUPPORT is not set
# CONFIG_SPL_DOS_PARTITION is not set

# The boot policy is built in; storage holds only its runtime state
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_ENV_WRITEABLE_LIST=y
CONFIG_ENV_ACCESS_IGNORE_FORCE=y
# CONFIG_ENV_IS_IN_NFS is not set
CONFIG_ZYL_OS=y

# No way into the shell or the environment from outside the device
CONFIG_BOOTDELAY=-2
# CONFIG_AUTOBOOT_KEYED is not set
# CONFIG_FASTBOOT_CMD_OEM_ENV_ACCESS is not set
# CONFIG_SPL_FASTBOOT_CMD_OEM_ENV_ACCESS is not set
# CONFIG_FASTBOOT_CMD_OEM_CONFIG_ACCESS is not set
# bootm (and "fastboot boot") takes only FITs, which it verifies: no legacy or
# Android images, which carry no signature
# CONFIG_LEGACY_IMAGE_FORMAT is not set
# CONFIG_ANDROID_BOOT_IMAGE is not set

# What the policy runs: the lock button, erasing /data, the slots
CONFIG_CMD_BUTTON=y
CONFIG_CMD_PART=y
CONFIG_CMD_MMC=y
