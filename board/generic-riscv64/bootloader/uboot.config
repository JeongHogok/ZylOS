# ----------------------------------------------------------
# [Clean Architecture] Infrastructure Layer - Bootloader Config
#
# 역할: generic-riscv64(QEMU virt) U-Boot 설정 조각 — qemu-riscv64_smode_defconfig 위에
# 수행범위: 커널 FIT 서명 검증, 부트 정책을 기본 환경으로(board/boot-policy.txt +
#           board/generic-riscv64/u-boot-env.txt), 저장소가 쓸 수 있는 변수는 정책의
#           "Runtime state" 뿐, 환경은 부트 파티션의 파일(자리·크기는 partitions.conf —
#           tools/build-bootloader.sh 가 이 조각에 붙인다), 콘솔에서 자동 부팅 중단 불가
# 의존방향: U-Boot Kconfig, tools/build-bootloader.sh --board generic-riscv64
# SOLID: SRP — 설정만
# ----------------------------------------------------------
CONFIG_FIT_SIGNATURE=y
CONFIG_RSA=y
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="virtio"
CONFIG_ENV_WRITEABLE_LIST=y
CONFIG_ENV_ACCESS_IGNORE_FORCE=y
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_BOOTDELAY=-2
# CONFIG_TOOLS_MKEFICAPSULE is not set
