#!/bin/bash
# ──────────────────────────────────────────────────────────
# [Clean Architecture] Infrastructure Layer - Developer CLI
#
# 역할: Zyl OS SDK CLI — 앱 생성, 검증, 개발자 키, 개발 빌드 패키징
# 수행범위: init → validate → keygen(공개 키를 스토어에 제출해 인증서·프로필을
#           받음) → package(개발자 키로 봉인한 .zpkg — 프로필의 기기에서만 실행)
# 의존방향: bash, python3, openssl, tools/build-store.py (봉인·패키지 형식의 단일 출처)
# SOLID: SRP — 개발자 도구 CLI만 담당
#
# 사용법:
#   zyl init <app-name>        — 새 앱 프로젝트 생성
#   zyl validate               — app.json + 코드 검증
#   zyl keygen [name]          — 개발자 키 쌍 생성 (~/.zyl/keys, 앱 폴더 밖)
#   zyl package --key --cert --profile [out-dir]
#                              — 개발 빌드 .zpkg (스토어가 서명한 인증서·프로필)
# ──────────────────────────────────────────────────────────
set -euo pipefail

VERSION="0.1.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

cmd_init() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "Usage: zyl init <app-name> [app-id]"
        echo "  Creates a new Zyl OS app project with boilerplate files."
        echo "  app-id: your reversed domain (com.example.<app-name> if omitted)."
        exit 1
    fi

    # com.zylos.* is the OS image's own apps
    local app_id="${2:-com.example.${name}}"
    local dir="$name"

    if [ -d "$dir" ]; then
        echo "✗ Directory already exists: $dir"
        exit 1
    fi

    echo "Creating Zyl OS app: $app_id"

    mkdir -p "$dir/js" "$dir/css"

    # app.json
    cat > "$dir/app.json" <<EOF
{
  "id": "$app_id",
  "name": "$name",
  "version": "1.0.0",
  "entry": "index.html",
  "description": "A Zyl OS app",
  "permissions": [],
  "formFactors": ["*"],
  "iconSvg": "M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20z"
}
EOF

    # index.html
    cat > "$dir/index.html" <<EOF
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>$name</title>
  <!-- The OS code, in apps/notes/index.html's order -->
  <link rel="stylesheet" href="../shared/runtime.css">
  <link rel="stylesheet" href="../shared/responsive.css">
  <script src="../shared/form-factor.js"></script>
  <script src="../shared/focus-nav.js"></script>
  <script src="../shared/touch-scroll.js" defer></script>
  <link rel="stylesheet" href="css/$name.css">
</head>
<body>
  <header class="app-header">
    <h1 data-i18n="$name.title">$name</h1>
  </header>
  <main id="content" role="main">
    <p data-i18n="$name.welcome">Welcome to $name</p>
  </main>
  <script src="../shared/i18n.js"></script>
  <script src="i18n.js"></script>
  <script src="../shared/bridge.js"></script>
  <script src="js/$name.js"></script>
</body>
</html>
EOF

    # CSS
    cat > "$dir/css/$name.css" <<EOF
/* [Clean Architecture] Presentation Layer - Stylesheet
 * 역할: $name 앱 스타일
 * 수행범위: 레이아웃, 색상, 타이포그래피
 * SOLID: SRP — 이 앱의 스타일만 담당 */

.app-header {
  padding: 16px 20px;
  font-size: 20px;
  font-weight: 600;
}

#content {
  padding: 20px;
}
EOF

    # JS
    cat > "$dir/js/$name.js" <<EOF
// [Clean Architecture] Presentation Layer - Logic
// 역할: $name 앱 로직
// 수행범위: UI 이벤트 처리, 서비스 호출
// 의존방향: ZylBridge (shared)
// SOLID: SRP — 이 앱의 로직만 담당

(function () {
  'use strict';

  function init() {
    // App initialization
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
EOF

    # i18n
    cat > "$dir/i18n.js" <<EOF
// [Clean Architecture] Shared Layer - i18n Data
// 역할: $name 앱 다국어 번역 데이터
// SOLID: SRP — 이 앱의 번역만 담당

(function () {
  'use strict';
  if (typeof zylI18n === 'undefined') return;

  zylI18n.addTranslations('ko', {
    '$name.title': '$name',
    '$name.welcome': '${name}에 오신 것을 환영합니다'
  });
  zylI18n.addTranslations('en', {
    '$name.title': '$name',
    '$name.welcome': 'Welcome to $name'
  });
  zylI18n.addTranslations('ja', {
    '$name.title': '$name',
    '$name.welcome': '${name}へようこそ'
  });
  zylI18n.addTranslations('zh', {
    '$name.title': '$name',
    '$name.welcome': '欢迎使用$name'
  });
  zylI18n.addTranslations('es', {
    '$name.title': '$name',
    '$name.welcome': 'Bienvenido a $name'
  });
})();
EOF

    echo "✓ Created app project: $dir/"
    echo ""
    echo "Files:"
    find "$dir" -type f | sed 's/^/  /'
    echo ""
    echo "Next steps:"
    echo "  1. Edit $dir/app.json (permissions, icon)"
    echo "  2. Develop in $dir/js/$name.js"
    echo "  3. Run: zyl validate (from $dir/)"
    echo "  4. Package: zyl package --key … --cert … --profile …"
}

cmd_validate() {
    if [ ! -f "app.json" ]; then
        echo "✗ app.json not found. Run from app directory."
        exit 1
    fi

    echo "═══ Validating Zyl OS App ═══"
    local errors=0

    # app.json structure
    echo "▸ app.json..."
    python3 -c "
import json, sys
m = json.load(open('app.json'))
required = ['id', 'name', 'version', 'entry']
for f in required:
    if f not in m or not m[f]:
        print(f'  ✗ Missing: {f}')
        sys.exit(1)
import re
# The store's rule (tools/build-store.py VERSION, the device's store_catalog.c)
if not re.match(r'^[0-9]+(\.[0-9]+)*$', m['version']):
    print(f'  ✗ Invalid version: {m[\"version\"]} (digits and dots, e.g. 1.2.3)')
    sys.exit(1)
# Entry file exists
if not __import__('os').path.exists(m['entry']):
    print(f'  ✗ Entry file not found: {m[\"entry\"]}')
    sys.exit(1)
print(f'  ✓ {m[\"id\"]} v{m[\"version\"]}')
" || errors=$((errors + 1))

    # ES5 check
    echo "▸ ES5 compliance..."
    local es6_violations=0
    for f in $(find . -name '*.js' -not -path './node_modules/*'); do
        # ERE, not grep -P: macOS grep has no -P, and the error hid every violation
        if grep -qE '(^|[^A-Za-z0-9_$])(const|let)([^A-Za-z0-9_$]|$)|=>' "$f"; then
            echo "  ✗ ES6+ syntax in $f"
            es6_violations=$((es6_violations + 1))
        fi
    done
    if [ $es6_violations -eq 0 ]; then
        echo "  ✓ All JS files are ES5 compatible"
    else
        errors=$((errors + es6_violations))
    fi

    # i18n check
    echo "▸ i18n completeness..."
    if [ -f "i18n.js" ]; then
        for lang in ko en ja zh es; do
            if ! grep -q "'$lang'" "i18n.js"; then
                echo "  ✗ Missing language: $lang"
                errors=$((errors + 1))
            fi
        done
        echo "  ✓ i18n.js has translations"
    else
        echo "  ⚠ No i18n.js found"
    fi

    # HTML check
    echo "▸ HTML structure..."
    local entry=$(python3 -c "import json; print(json.load(open('app.json'))['entry'])" 2>/dev/null || echo "index.html")
    if [ -f "$entry" ]; then
        if head -1 "$entry" | grep -qi "doctype"; then
            echo "  ✓ DOCTYPE present"
        else
            echo "  ✗ Missing DOCTYPE in $entry"
            errors=$((errors + 1))
        fi
    fi

    echo ""
    if [ $errors -eq 0 ]; then
        echo "✓ Validation passed"
    else
        echo "✗ $errors error(s) found"
        exit 1
    fi
}

cmd_package() {
    if [ ! -f "app.json" ]; then
        echo "✗ app.json not found. Run from app directory."
        exit 1
    fi
    local key="" cert="" profile="" signing="" out=".."
    while [ $# -gt 0 ]; do
        case "$1" in
            --key|--cert|--profile|--signing)
                [ $# -ge 2 ] || { echo "✗ $1 needs a file"; exit 1; }
                case "$1" in --key) key="$2" ;; --cert) cert="$2" ;; --profile) profile="$2" ;; --signing) signing="$2" ;; esac
                shift 2 ;;
            *) out="$1"; shift ;;
        esac
    done
    if [ -z "$key" ] || [ -z "$cert" ] || [ -z "$profile" ] || [ -z "$signing" ]; then
        echo "Usage: zyl package --key <developer.key> --cert <developer.cert.json> --profile <app.profile.json> --signing <signing.json> [out-dir]"
        echo "  The app store signs your certificate and profile (send it your public key"
        echo "  and the device IDs from Settings > About) and gives them to you with its"
        echo "  signing certificate (signing.json); the package installs only on those"
        echo "  devices. Default out-dir: the parent directory."
        exit 1
    fi
    python3 -I "$SCRIPT_DIR/build-store.py" package --key "$key" --signing "$signing" --cert "$cert" --profile "$profile" . "$out"
}

cmd_keygen() {
    local name="${1:-developer}"
    local dir="${ZYL_KEYS:-$HOME/.zyl/keys}"
    if [ -e "$dir/$name.key" ]; then
        echo "✗ Already exists: $dir/$name.key"
        exit 1
    fi
    # Outside any app folder: a key in one would be packaged with the app
    mkdir -p "$dir" && chmod 700 "$dir"
    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$dir/$name.key" 2>/dev/null
    chmod 600 "$dir/$name.key"
    openssl pkey -in "$dir/$name.key" -pubout -out "$dir/$name.pub"
    echo "✓ Private key: $dir/$name.key (KEEP SECRET)"
    echo "✓ Public key:  $dir/$name.pub (send to the app store for your certificate)"
}

cmd_help() {
    echo "Zyl OS Developer CLI v$VERSION"
    echo ""
    echo "Commands:"
    echo "  zyl init <name>          Create new app project"
    echo "  zyl validate             Validate current app"
    echo "  zyl keygen [name]        Generate a developer key pair (~/.zyl/keys)"
    echo "  zyl package --key K --cert C --profile P [out-dir]"
    echo "                           Seal a development build (.zpkg)"
    echo "  zyl help                 Show this help"
}

# ─── Dispatch ───
case "${1:-help}" in
    init)     shift; cmd_init "$@" ;;
    validate) cmd_validate ;;
    package)  shift; cmd_package "$@" ;;
    keygen)   shift; cmd_keygen "$@" ;;
    help|*)   cmd_help ;;
esac
