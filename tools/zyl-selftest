#!/bin/bash
# ──────────────────────────────────────────────────────────
# [Clean Architecture] Infrastructure Layer - Diagnostics
#
# 역할: 부팅한 Zyl OS 가 제대로 서 있는지 스스로 점검해 한 줄로 보고한다
# 수행범위: 설치된 zyl 유닛이 활성인지, 그 유닛이 선언한 D-Bus 이름이 실제로
#           시스템 버스에 있는지, 앱 디렉터리와 /data 가 있는지
# 의존방향: systemctl, gdbus. 기대 목록을 스스로 갖지 않고 **설치된 유닛의
#           BusName= 에서 끌어낸다 (프로파일마다 서비스 집합이 다르다)
# SOLID: SRP — 점검과 보고만. 고치지 않는다
#        DIP — "무엇이 있어야 하는가"를 유닛 파일에서 읽는다
#
# 기본으로 켜지 않는다 (유닛에 [Install] 이 없다). 기기에는 셸이 없으니 커널 인자
# systemd.wants=zyl-selftest.service 로 부른다 (QEMU 레인·공장 검사)
# ──────────────────────────────────────────────────────────
set -uo pipefail

UNIT_DIRS=(/usr/lib/systemd/system /lib/systemd/system /etc/systemd/system)
pass=0
fail=0
failed=""        # 직렬 콘솔은 줄을 흘린다 — 실패는 마지막에 다시 적는다
skip=0
say()  { echo "zyl-selftest: $*"; }
ok()   { say "ok   $*"; pass=$((pass + 1)); }
bad()  { say "FAIL $*"; fail=$((fail + 1)); failed="$failed\n  $*"; }
# 하드웨어가 없어 systemd 가 건너뛴 유닛은 실패가 아니다 (Condition*= 미충족).
# 화면 없는 어플라이언스에 DRM 이 없는 것은 정상이다
skipped() { say "skip $*"; skip=$((skip + 1)); }
condition_failed() { [ "$(systemctl show -p ConditionResult --value "$1" 2>/dev/null)" = "no" ]; }

# ── 1. 유닛: 설치된 zyl-* 서비스가 활성인가 ──
units=""
for d in "${UNIT_DIRS[@]}"; do
    [ -d "$d" ] || continue
    for u in "$d"/zyl-*.service; do
        [ -e "$u" ] || continue
        b="$(basename "$u")"
        case " $units " in *" $b "*) continue ;; esac
        units="$units $b"
    done
done
[ -n "$units" ] || bad "설치된 zyl 유닛이 없다"

for u in $units; do
    # 자기점검 자신과 oneshot 보조 유닛은 활성 여부를 묻지 않는다
    case "$u" in zyl-selftest.service|zyl-apparmor.service) continue ;; esac
    state="$(systemctl is-active "$u" 2>/dev/null)"
    # 아직 올라오는 중이면 기다려 준다 — WAM 은 WebKit 과 홈 앱을 띄우느라
    # 느리고(에뮬레이션에서는 더), 시작 중인 유닛은 실패가 아니다
    i=0
    while [ "$state" = "activating" ] && [ $i -lt 30 ]; do
        sleep 1; i=$((i + 1))
        state="$(systemctl is-active "$u" 2>/dev/null)"
    done
    if [ "$state" = "active" ]; then ok "unit $u"
    elif condition_failed "$u"; then skipped "unit $u (하드웨어 조건 미충족)"
    else
        why="$(systemctl show -p Result --value "$u" 2>/dev/null)"
        code="$(systemctl show -p ExecMainStatus --value "$u" 2>/dev/null)"
        bad "unit $u ($state, result=${why:-?}, exit=${code:-?})"
        # 왜 죽었는지가 보통 여기 있다 — 기기에서 1차 진단이 된다
        journalctl -u "$u" -n 3 --no-pager -o cat 2>/dev/null | sed 's/^/zyl-selftest:      | /'
    fi
done

# ── 2. 버스: 유닛이 선언한 이름이 시스템 버스에 있는가 ──
for u in $units; do
    condition_failed "$u" && continue      # 건너뛴 유닛의 이름을 찾을 이유가 없다
    name=""
    for d in "${UNIT_DIRS[@]}"; do
        [ -f "$d/$u" ] || continue
        name="$(sed -n 's/^BusName=//p' "$d/$u" | head -1)"
        [ -n "$name" ] && break
    done
    [ -n "$name" ] || continue
    path="/$(echo "$name" | tr '.' '/')"
    if gdbus introspect --system -d "$name" -o "$path" >/dev/null 2>&1; then
        ok "bus $name"
    else
        bad "bus $name (이름이 없거나 응답하지 않는다)"
    fi
done

# ── 3. 이미지가 제자리에 있는가 ──
[ -d /usr/share/zyl-os/apps/home ] && ok "apps /usr/share/zyl-os/apps" \
    || bad "apps 디렉터리가 없다"
[ -f /usr/share/zyl-os/wam/bridge.js ] && ok "wam bridge.js" \
    || bad "wam/bridge.js 가 없다"
mountpoint -q /data && ok "/data 마운트" || bad "/data 가 마운트되지 않았다"
[ -f /etc/zyl-release ] && ok "release $(sed -n 's/^ZYL_OS_VERSION=//p' /etc/zyl-release | head -1)" \
    || bad "/etc/zyl-release 가 없다"

# ── 4. 화면 체인 (있으면) ──
if [ -e /dev/dri/card0 ]; then
    ok "drm /dev/dri/card0"
    if [ -S /run/zyl-session/wayland-0 ]; then ok "wayland /run/zyl-session/wayland-0"
    else bad "wayland 소켓이 없다 (컴포지터가 화면을 잡지 못했다)"; fi
    # 화면 체인의 끝: WAM 이 실제로 앱을 띄웠는가. 소켓만 있고 창이 없으면
    # 사용자는 검은 화면을 본다
    running="$(gdbus call --system -d org.zylos.WebAppManager \
        -o /org/zylos/WebAppManager -m org.zylos.WebAppManager.ListRunning \
        2>/dev/null)"
    # 응답은 (['com.zylos.home'], 1) 꼴 — 앱 id 를 여기 또 적지 않고 개수만 본다
    count="${running##*, }"; count="${count%)}"
    if [ -z "$running" ]; then bad "wam ListRunning 이 응답하지 않는다"
    elif [ "${count:-0}" -gt 0 ] 2>/dev/null; then ok "wam 앱 실행 중 $running"
    else bad "wam 이 띄운 앱이 없다 ($running)"; fi
else
    skipped "drm 장치 없음 — 화면 없는 기기면 정상 ($(ls /dev/dri 2>/dev/null | tr '\n' ' '))"
fi

# ── 저장소: 루트는 읽기 전용(기기에서는 dm-verity), 남는 것은 /data, /var 는 휘발 ──
opts="$(findmnt -n -o OPTIONS / 2>/dev/null)"
case ",$opts," in
    *,ro,*) ok "루트 읽기 전용" ;;
    *) bad "루트가 쓰기 가능하다 ($opts)" ;;
esac
if [ "$(findmnt -n -o FSTYPE /var 2>/dev/null)" = tmpfs ]; then ok "/var 휘발(tmpfs)"
else bad "/var 가 tmpfs 가 아니다 — 읽기 전용 루트에서 쓰기가 실패한다"; fi
mountpoint -q /boot && ok "/boot 마운트" || bad "/boot 가 마운트되지 않았다 — 업데이터·부트 환경이 쓰는 곳"

# ── A/B: 부트로더가 띄운 슬롯이 확정되는가 ──
# 커널 인자의 zyl.slot= 은 서명된 FIT 이 준다 — 없으면 QEMU 가 커널을 직접 띄운 것
slot="$(sed -n 's/.*zyl\.slot=\([ab]\).*/\1/p' /proc/cmdline)"
if [ -z "$slot" ]; then
    skipped "A/B — 부트로더 없이 부팅"
elif ! active="$(fw_printenv -n zyl_active_slot 2>/dev/null)"; then
    bad "부트로더 환경을 읽지 못한다 (/etc/fw_env.config) — 업데이트·잠금 해제가 꺼진다"
else
    # 시험 중인 슬롯(zyl_next_slot)이면 업데이터가 건강 검사 뒤 확정할 때까지 기다린다
    # (업데이터는 기동 후 1분에 확정한다 — 유닛의 TimeoutStartSec 안에서 끝나야 한다)
    i=0
    while [ "$(fw_printenv -n zyl_next_slot 2>/dev/null)" = "$slot" ] && [ $i -lt 110 ]; do
        sleep 2; i=$((i + 2))
    done
    active="$(fw_printenv -n zyl_active_slot 2>/dev/null)"
    if [ "$active" = "$slot" ]; then ok "슬롯 $slot 부팅·확정 (zyl_active_slot=$active)"
    else
        bad "슬롯 $slot 로 부팅했는데 확정되지 않았다 (zyl_active_slot=$active, zyl_next_slot=$(fw_printenv -n zyl_next_slot 2>/dev/null))"
        # 기기에는 셸이 없다 — 왜 확정하지 않았는지는 업데이터의 기록이 콘솔로 말한다
        journalctl -u zyl-updater -n 20 -o cat --no-pager 2>/dev/null | while IFS= read -r l; do say "  updater: $l"; done
    fi
fi

# ── 보고 ──
# 기록을 디스크로 — 레인은 PASS 를 보자마자 머신을 끈다(업데이터가 쓴 부트 환경 등)
sync
total=$((pass + fail))
if [ "$fail" -eq 0 ]; then
    say "PASS ($pass/$total, 건너뜀 $skip)"
    exit 0
fi
say "FAILED ($fail/$total 실패, 건너뜀 $skip)"
# shellcheck disable=SC2059  # \n 을 실제 줄바꿈으로 펴는 것이 목적이다
printf "zyl-selftest: 실패 목록:$failed\n" >&2
exit 1
