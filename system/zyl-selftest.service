# ──────────────────────────────────────────────────────────
# [Clean Architecture] Infrastructure Layer - Diagnostics Unit
#
# 역할: 부팅 자기점검을 OS 가 다 선 뒤에 한 번 돌린다
# 수행범위: /usr/bin/zyl-selftest 실행, 결과를 콘솔과 journal 에 남김
# 의존방향: zyl-os.target (그 뒤에 돈다), tools/zyl-selftest
# SOLID: SRP — 점검 실행만
#
# [Install] 이 없다 = 기본으로 켜지지 않는다. 기기에는 셸이 없으니 부르는 길은
# 커널 인자 systemd.wants=zyl-selftest.service 하나다 (QEMU 레인·공장 검사 —
# 실기기는 커널 인자가 서명된 이미지에 들어 있어 그 인자로 서명한 이미지가 필요)
# ──────────────────────────────────────────────────────────

[Unit]
Description=Zyl OS self test
After=zyl-os.target
Wants=zyl-os.target

[Service]
Type=oneshot
ExecStart=/usr/bin/zyl-selftest
RemainAfterExit=yes
# 콘솔로도 보내야 직렬 콘솔만 있는 기기와 QEMU 에서 결과를 읽을 수 있다
StandardOutput=journal+console
StandardError=journal+console
# 56개 검사 + 시작 중인 유닛 대기 — 에뮬레이션에서는 1분으로 모자란다
TimeoutStartSec=180
