[Unit]
Description=Zyl OS Data Usage Service (NetStats)
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/zyl-netstats
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=120
TimeoutStopSec=5

# Reads /sys/class/net counters, drives nmcli for the mobile data limit
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/netstats
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=zyl-os.target
