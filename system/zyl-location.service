[Unit]
Description=Zyl OS Location Service
After=dbus.service zyl-compositor.service
Wants=zyl-compositor.service

[Service]
Type=dbus
BusName=org.zylos.LocationService
ExecStart=/usr/bin/zyl-location
# Its own user (system/sysusers.d/zyl-services.conf): what it parses comes from
# the network — taken over, it is no root, owns no other service's bus name and
# reaches only what system/dbus-1/zyl-os.conf lets it
User=zyl-location
Group=zyl-location
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
SupplementaryGroups=netdev
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

# Security hardening — handles sensitive location data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
