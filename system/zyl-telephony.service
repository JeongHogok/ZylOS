[Unit]
Description=Zyl OS Telephony Service
After=dbus.service ModemManager.service
Wants=ModemManager.service

[Service]
Type=dbus
BusName=org.zylos.Telephony
ExecStart=/usr/bin/zyl-telephony
# Still root: ModemManager's bus policy lets only root set the emergency alert
# channels (CellBroadcast) and asks polkit — not on the image — for the rest, and
# NetworkManager (nmcli) refuses other users. Taken over by a crafted SMS or
# alert, it holds no kernel capability: it cannot ptrace other services,
# remount, load modules or override file permissions
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# Emergency alert history (Cell Broadcast)
ReadWritePaths=/data/alerts /data/telephony
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
