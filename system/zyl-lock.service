[Unit]
Description=Zyl OS Lock Credential Service (screen lock PIN)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/zyl-lock
Restart=on-failure
RestartSec=10
TimeoutStopSec=5

# Holds only the PIN hash, failure count and sealed storage key in /data/lock
# (zyl-lock-prepare.service made it; a right PIN puts the key on /data)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/lock
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=zyl-os.target
