[Unit]
Description=Zyl OS File Service (the user's files)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/zyl-fs
Restart=on-failure
RestartSec=10
TimeoutStopSec=5

# The user's file tree under /data/users, and third-party apps' own files in
# their containers under /data/appdata
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/users /data/appdata
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=zyl-os.target
