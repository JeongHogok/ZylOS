[Unit]
Description=Zyl OS Web Application Manager
After=zyl-compositor.service
Requires=zyl-compositor.service
PartOf=zyl-compositor.service
# 앱 런타임은 화면 장치가 있어야 뜻이 있다. 없으면 컴포지터와 함께 건너뛴다
# (zyl-compositor.service 와 같은 조건) — 화면 없는 보드에서 부팅이 깨지지 않게
ConditionPathExists=/dev/dri/card0

[Service]
Type=dbus
BusName=org.zylos.WebAppManager

# Run as dedicated non-root service account instead of root.
# The zyl-wam user must be created by the installer/package:
#   useradd -r -s /usr/sbin/nologin -d /var/lib/zyl-os/wam -G video,render zyl-wam
# XDG_RUNTIME_DIR is set by pam_systemd or the RuntimeDirectory directive.
User=zyl-wam
Group=zyl-wam
# video/render groups required for DRI/GPU access
SupplementaryGroups=video render

# Wayland 소켓은 컴포지터의 런타임 디렉터리에 있다. 절대 경로를 주면
# XDG_RUNTIME_DIR 과 달라도 된다 — WAM 은 자기 런타임 디렉터리를 따로 쓴다
Environment=WAYLAND_DISPLAY=/run/zyl-session/wayland-0
RuntimeDirectory=zyl-wam
RuntimeDirectoryMode=0700
# XDG_RUNTIME_DIR must match the RuntimeDirectory path so WebKit/Wayland
# socket lookup works correctly under the zyl-wam service account.
Environment=XDG_RUNTIME_DIR=/run/zyl-wam

ExecStart=/usr/bin/zyl-wam
Restart=on-failure
RestartSec=2
# 앱이 안 뜰 때 단서는 여기뿐이다 (직렬 콘솔만 있는 기기·QEMU 레인)
StandardOutput=journal+console
StandardError=journal+console

# Security hardening
# false 여야 한다: NNP 가 걸리면 커널이 AppArmor 프로필 전이를 권한 상승으로 보고
# /usr/bin/bwrap 의 exec 를 거부한다("no new privs") — WebKit 샌드박스가 아예
# 시작하지 못한다. 격리는 bubblewrap 네임스페이스 + seccomp + bwrap 자식 프로필이
# 담당하고, 이 프로필은 exec 대상을 WebKit 헬퍼로 한정한다 (QEMU 레인이 잡았다)
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
# false 여야 한다: systemd 가 /proc/sys 를 읽기 전용으로 덮으면 그 잠긴
# 마운트 때문에 커널이 사용자 네임스페이스 안의 proc 마운트를 거부한다
# ("bwrap: Can't mount proc on /proc") — WebKit 샌드박스가 못 뜬다.
# zyl-wam 은 비루트라 /proc/sys 에 쓸 수 없고 AppArmor 도 막는다
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
# WebKit wraps every web process in bubblewrap, which creates user/mount/pid
# namespaces. RestrictNamespaces=true blocks that, and webkitgtk-6.0 cannot run
# its web processes unsandboxed — the WAM would start but no app would load.
RestrictNamespaces=false
# App data directories; /data/appdata: each app's WebKit storage in its container
ReadWritePaths=/data/apps /data/appdata /var/lib/zyl-os/wam /var/cache/zyl-os/wam

[Install]
WantedBy=graphical.target
