# ──────────────────────────────────────────────────────────
# [Clean Architecture] Infrastructure Layer - Image Contents
#
# 역할: OS 이미지가 실행 시점에 필요한 배포 패키지 단일 출처 (Debian 계열 이름)
# 수행범위: 패키지 이름만. 어떻게 설치할지는 tools/build-image.sh 가 안다
# 의존방향: 없음 (순수 목록). 읽는 쪽: tools/build-image.sh
# SOLID: SRP — "무엇이 필요한가"만 선언, OCP — 줄을 더하면 이미지에 들어간다
#
# 한 줄에 하나. '#' 뒤는 주석. 빠지면 무엇이 깨지는지 적을 것 —
# 없는 채로 부팅하면 조용히 기능만 사라지는 것들이 있다.
# ──────────────────────────────────────────────────────────

# ── 부팅·초기화 ──
systemd                 # zyl-os.target, 모든 서비스 유닛
systemd-sysv            # /sbin/init
dbus                    # 서비스 버스 (system/dbus-1/zyl-os.conf 정책)
dbus-user-session        # 세션 없이도 dbus-daemon 패키징 의존 충족
udev                    # 입력·DRM 장치 노드
libpam-systemd          # 로그인 없이도 systemd 통합
e2fsprogs               # /data ext4 체크·마운트
libglib2.0-bin          # gdbus — zyl-selftest 가 버스 이름을 확인한다
util-linux              # mountpoint, setpriv

# ── 서비스가 링크하는 런타임 라이브러리 ──
# 빠지면 데몬이 exit 127(동적 링커 실패)로 죽는다. tools/build-image.sh 가
# 설치된 바이너리의 DT_NEEDED 를 읽어 이 목록이 모자라면 빌드를 거부한다
libjson-glib-1.0-0      # 거의 모든 서비스 (JSON 상태·IPC)
libcurl4t64             # network·updater·appstore (HTTP)
libzip5                 # appstore (.zpkg 해제)
libssl3t64              # credential·appstore·updater (서명·암호화)
libgps30t64             # location (gpsd)

# ── 그래픽·앱 런타임 ──
libgtk-4-1              # WAM (GTK4)
libwebkitgtk-6.0-4      # 앱 런타임. 없으면 앱이 하나도 뜨지 않는다
bubblewrap              # WebKit 웹 프로세스 샌드박스. 없으면 격리가 조용히 꺼진다
xdg-dbus-proxy          # 같은 샌드박스의 D-Bus 필터
libwlroots-0.18        # 컴포지터 (패키지 이름은 배포판마다 다르다)
libinput10               # 터치·키보드
libdrm2                 # KMS 출력
libgles2                # GL ES API (libglvnd 디스패치)
libegl1                 # EGL API (libglvnd 디스패치)
# **드라이버**: 위 둘은 디스패처일 뿐이고 실제 구현은 Mesa 가 준다. 없으면
# GL/EGL 초기화가 실패하고 WAM 이 세그폴트로 죽는다 (QEMU 레인이 잡았다).
# GPU 독점 드라이버를 못 쓰는 기기에서는 이 소프트웨어 경로(llvmpipe)가 유일하다
libgl1-mesa-dri         # DRI 드라이버 (swrast/llvmpipe 포함)
libegl-mesa0            # Mesa EGL 플랫폼 드라이버
libglx-mesa0            # Mesa GLX
libdisplay-info2        # EDID/모니터 정보
libseat1                # 시트 관리
libpixman-1-0           # 컴포지터 소프트웨어 렌더링
libwayland-server0      # 컴포지터
libxkbcommon0           # 키 배열
xkb-data                # 키 배열 규칙(rules/evdev). 없으면 GTK 가 키맵을 못 만들고
                        # WAM 이 세그폴트로 죽는다 (QEMU 레인이 잡았다)
libgbm1                 # DRM 버퍼 할당

# ── 글꼴 (없으면 한·중·일 UI 와 이모지가 전부 두부 ▯) ──
fontconfig               # fc-cache — 이미지 빌드 때 글꼴 캐시를 구운다
fonts-noto-core
fonts-noto-mono
fonts-noto-cjk
fonts-noto-color-emoji

# ── 네트워크·모뎀 ──
network-manager                      # wifi·모바일 데이터
modemmanager                         # 통화·SMS·재난문자
mobile-broadband-provider-info       # APN 자동 설정
wpasupplicant                        # WiFi 인증
bluez                                # 블루투스

# ── 미디어 ──
pipewire                 # 오디오 경로
pipewire-pulse
wireplumber

# ── 보안·무결성 ──
apparmor                 # system/apparmor/zyl-* 프로필
apparmor-utils           # apparmor_parser (zyl-apparmor.service)
cryptsetup-bin           # dm-verity (veritysetup)
openssl                  # 서명 검증 도구

# ── 그 밖 ──
ca-certificates          # HTTPS (스토어·OTA)
tzdata                   # 시간대
