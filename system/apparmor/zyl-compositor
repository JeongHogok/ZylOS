# ----------------------------------------------------------
# [Clean Architecture] Infrastructure Layer - Security Policy
#
# 역할: Zyl OS Compositor AppArmor 프로필
# 수행범위: 컴포지터 프로세스의 파일/디바이스/소켓 접근 제한
# 의존방향: /usr/bin/zyl-compositor 바이너리에 적용
# SOLID: SRP — 컴포지터 프로세스 격리 정책만 담당
# ----------------------------------------------------------

#include <tunables/global>

# flags=(attach_disconnected): 유닛이 ProtectSystem=strict·PrivateTmp 로
# 마운트 네임스페이스 안에서 돌기 때문에, 그 안에서 열린 /dev/dri 같은
# 경로가 AppArmor 에게 'disconnected path' 로 보여 거부된다
profile zyl-compositor /usr/bin/zyl-compositor flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/dbus-session>

  # Compositor binary
  /usr/bin/zyl-compositor           mr,

  # Zyl OS shared resources (read-only)
  /usr/share/zyl-os/**              r,

  # wlroots and compositor libraries
  /usr/lib/zyl-os/**                mr,
  /usr/lib/@{multiarch}/**          mr,

  # GPU / DRI / input device access
  /dev/dri/                         r,
  /dev/dri/**                       rw,
  /dev/input/**                     r,
  /dev/uinput                       rw,
  /sys/devices/**/drm/**            r,
  /sys/class/input/**               r,
  /sys/class/drm/**                 r,

  # Framebuffer (fallback rendering)
  /dev/fb*                          rw,

  # Wayland socket creation — 유닛의 RuntimeDirectory=zyl-session 와 같은 경로
  /run/zyl-session/                 rwk,
  /run/zyl-session/**               rwk,

  # Cursor themes
  /usr/share/icons/**               r,
  owner @{HOME}/.icons/**           r,

  # XKB keyboard layouts
  /usr/share/X11/xkb/**             r,

  # Temporary files (owner-only)
  owner /tmp/zyl-compositor-*       rwk,

  # Runtime state (systemd 가 만드는 RuntimeDirectory)
  /run/zyl-session/**               rwk,

  # D-Bus session bus (compositor signals)
  dbus (send, receive) bus=session
       peer=(name=org.zylos.*),

  # GL/EGL 벤더 목록, 드라이버 설정, 장치 열거. Mesa 는 PCI 속성으로 드라이버를
  # 고르는데 ARM·RISC-V 는 PCI 가 platform 아래 달려 표준 추상화가 닿지 않는다
  /usr/share/glvnd/egl_vendor.d/{,**} r,
  /etc/glvnd/egl_vendor.d/{,**}       r,
  /usr/share/drirc.d/{,**}            r,
  /etc/drirc                          r,
  /sys/devices/**/drm/                r,
  /sys/devices/**/{vendor,device,subsystem_vendor,subsystem_device,revision,class,config,uevent} r,

  # 시작할 때 자기 권한을 한 번 떠보는 것들(GLib·libudev). 없어도 동작하므로
  # 주지 않고, 감사 로그만 조용히 한다
  deny capability net_admin,
  deny capability sys_admin,
  deny capability dac_override,
  deny capability dac_read_search,

  # udev 이벤트 모니터: wlroots 가 DRM·입력 장치 변화를 듣는 통로다.
  # 막으면 "Failed to create udev monitor" 로 세션 생성에 실패하고 화면이 아예
  # 안 나온다 (QEMU 레인이 잡았다)
  network netlink raw,

  # Deny network access — compositor has no need
  deny network inet stream,
  deny network inet dgram,
  deny network inet6 stream,
  deny network inet6 dgram,

  # Deny write to system directories
  deny /usr/**                      w,
  deny /etc/**                      w,
  deny /boot/**                     rwmlkx,

  # Deny direct memory access
  deny /dev/mem                     rwmlkx,
  deny /dev/kmem                    rwmlkx,
  deny /proc/kcore                  rwmlkx,
}
